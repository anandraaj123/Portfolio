# =========================================================================
# Next.js Server-Side Credentials (NEVER expose to git or client code!)
# Copy this file to .env.local and fill in the values.
# =========================================================================

# Google Gemini AI API Key
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key
# Obtain from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK credentials (Firestore write access)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# Make sure to wrap the private key in double quotes and preserve newline characters (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
